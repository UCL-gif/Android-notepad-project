<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/swipe_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:gravity="end"
        >

        <TextView
            android:id="@+id/fl_tv_pinned"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="置顶"
            android:textSize="30sp"
            android:gravity="center"
            android:background="@drawable/item_layout_linear_background"

            />
        <TextView
            android:id="@+id/fl_tv_todo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="待办"
            android:textSize="30sp"
            android:gravity="center"
            android:background="@drawable/item_layout_linear_background"

            />
        <TextView
            android:id="@+id/fl_tv_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="删除"
            android:textSize="30sp"
            android:gravity="center"
            android:background="@drawable/item_layout_linear_background"

            />

    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/foreground_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="5dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="这是标题哇哇" />
                <ImageView
                    android:id="@+id/iv_pinned"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="是否为置顶状态"
                    android:src="@drawable/pinned"
                    android:visibility="gone"
                    />

            </LinearLayout>

            <TextView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.78"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textSize="15sp"
                tools:text="这是内容部分噢噢噢噢" />

            <TextView
                android:id="@+id/create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:alpha="0.55"
                android:textSize="12sp"
                tools:text="2026年9月13日 15:30:00" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

